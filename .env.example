# Configurações do Achilles CDP Agent

# Token opcional para autenticação no REST Bridge (se omitido, um token de 32 bytes é gerado aleatoriamente no startup)
ACHILLES_API_TOKEN=

# Porta padrão de escuta para depuração remota do Chrome CDP
ACHILLES_CDP_PORT=9222

# Porta do servidor REST Bridge
ACHILLES_REST_PORT=8765

# Habilita testes de navegador reais descartáveis (Playwright Chromium) durante a execução de testes
ACHILLES_BROWSER_TESTS=0

# Idioma padrão da interface CLI (pt / en)
ACHILLES_LANG=pt
