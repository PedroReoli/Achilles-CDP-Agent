.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Build & Distribution ---
build/
dist/
*.manifest

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test-results/
